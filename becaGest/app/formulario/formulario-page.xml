
<Page navigatingTo="onNavigatingTo"
      xmlns="http://schemas.nativescript.org/tns.xsd">

    <ActionBar title="Nueva tarea" />

    <ScrollView>
        <StackLayout class="formulario">

            <!-- Encabezado del formulario -->
            <Label text="Registrar nueva tarea"
                   class="formulario-titulo" />

            <Label text="Complete los datos para registrar una tarea."
                   class="formulario-subtitulo"
                   textWrap="true" />

            <Label text="* Todos los campos son obligatorios."
                   class="formulario-ayuda" />

            <!-- Campo título -->
            <Label text="Título *" class="etiqueta" />

            <TextField text="{{ titulo }}"
                       hint="Ej. Revisar solicitudes"
                       class="campo-formulario" />

            <Label text="{{ errorTitulo }}"
                   visibility="{{ visTitulo }}"
                   class="error"
                   textWrap="true" />

            <!-- Campo descripción -->
            <Label text="Descripción *" class="etiqueta" />

            <TextView text="{{ descripcion }}"
                      hint="Escriba al menos 10 caracteres"
                      height="100"
                      class="campo-formulario" />

            <Label text="{{ errorDescripcion }}"
                   visibility="{{ visDescripcion }}"
                   class="error"
                   textWrap="true" />

            <!-- Campo fecha límite -->
            <Label text="Fecha límite *" class="etiqueta" />

            <TextField text="{{ fechaLimite }}"
                       hint="dd/mm/aaaa"
                       keyboardType="datetime"
                       class="campo-formulario" />

            <Label text="{{ errorFechaLimite }}"
                   visibility="{{ visFechaLimite }}"
                   class="error"
                   textWrap="true" />

            <Label text="Ejemplo: 25/12/2026"
                   class="formulario-ayuda" />

            <!-- Botones del formulario -->
            <Button text="Guardar tarea"
                    tap="onGuardar"
                    class="-primary"
                    marginTop="24" />

            <Button text="Cancelar"
                    tap="onCancelar"
                    class="-outline" />

        </StackLayout>
    </ScrollView>

</Page>
